<Window x:Class="LGCastPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LGCastPC"
        mc:Ignorable="d"
        Title="LG Cast PC" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Fila 0: Título principal de la aplicación -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Panel de controles (IP y Botones) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Área de logs (ocupa todo el espacio vertical restante) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título principal -->
        <TextBlock Grid.Row="0"
                   Text="LG Cast PC"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Panel de configuración y exploración -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <!-- Grupo de Conexión y Pruebas -->
            <GroupBox Header="Conexión" Margin="0,0,0,10" Padding="10">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="IP de la TV:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <TextBox x:Name="TxtIpTv" Text="192.168.1.5" Width="110" Padding="5,3" VerticalAlignment="Center" Margin="0,0,8,5"/>
                    <Button x:Name="BtnConectar" Content="Conectar" Padding="8,4" Margin="0,0,6,5" Click="BtnConectar_Click"/>
                    <Button x:Name="BtnProbarSsap" Content="Probar SSAP" Padding="8,4" Margin="0,0,6,5" Click="BtnProbarSsap_Click"/>
                    <Button x:Name="BtnProbarSsapBasico" Content="Probar SSAP Básico" Padding="8,4" Margin="0,0,6,5" Click="BtnProbarSsapBasico_Click"/>
                    <Button x:Name="BtnAppActiva" Content="App Activa" Padding="8,4" Margin="0,0,0,5" Click="BtnAppActiva_Click"/>
                </WrapPanel>
            </GroupBox>

            <!-- Grupo de Exploración SSAP / AppCasting -->
            <GroupBox Header="Exploración SSAP / AppCasting" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtUriCustom"
                             Grid.Column="0"
                             Text="ssap://com.webos.service.appcasting/getServiceList"
                             Padding="5,3"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnEnviarCustom"
                                Content="Enviar URI"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="BtnEnviarCustom_Click"/>

                        <Button x:Name="BtnMapearServicios"
                                Content="Mapear Servicios"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="BtnMapearServicios_Click"/>

                        <Button x:Name="BtnExplorarAppCasting"
                                Content="Explorar AppCasting"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="BtnExplorarAppCasting_Click"/>

                        <Button x:Name="BtnSuscribirAppCasting"
                                Content="Suscribir AppCasting"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="BtnSuscribirAppCasting_Click"/>

                        <Button x:Name="BtnProbarConnect"
                                Content="Probar CONNECT"
                                Padding="10,4"
                                Click="BtnProbarConnect_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Grupo de Inspección AppCasting (sendCommand) -->
            <GroupBox Header="Inspección AppCasting (sendCommand)" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="cmd:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium"/>
                    <TextBox x:Name="TxtAppCastCmd" Grid.Column="1" Text="CONNECT" Padding="5,3" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Payload Extra (JSON):" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium"/>
                    <TextBox x:Name="TxtAppCastPayloadExtra" Grid.Column="3" Padding="5,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox.Text>{}</TextBox.Text>
                    </TextBox>

                    <Button x:Name="BtnEnviarAppCastCustom" Grid.Column="4" Content="Enviar AppCast" Padding="10,4" Click="BtnEnviarAppCastCustom_Click"/>
                </Grid>
            </GroupBox>

            <!-- Grupo de Reproducción Exacta de Mensajes LG ThinQ -->
            <GroupBox Header="Reproducción Exacta de Mensajes LG ThinQ" Margin="0,10,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URI SSAP:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <TextBox x:Name="TxtUriRepro" Grid.Row="0" Grid.Column="1" Text="ssap://com.webos.service.appcasting/sendCommand" Padding="5,3" VerticalAlignment="Center" Margin="0,0,10,5"/>

                    <Button x:Name="BtnEnviarRaw" Grid.Row="0" Grid.Column="2" Content="Enviar Mensaje Bruto" Padding="12,4" Margin="0,0,0,5" Click="BtnEnviarRaw_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Payload Bruto:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <TextBox x:Name="TxtPayloadRaw" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="5,3" VerticalAlignment="Center">
                        <TextBox.Text>{"cmd":"CONNECT"}</TextBox.Text>
                    </TextBox>
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- Área grande de logs -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Registro de Actividad (Logs):"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <!-- Cuadro de texto multilínea de solo lectura para mostrar el historial de eventos -->
            <TextBox x:Name="TxtLogs"
                     Grid.Row="1"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#F8F9FA"
                     Padding="8"/>
        </Grid>
    </Grid>
</Window>
